NODE_ENV=development
PORT=3000
# Comma-separated browser origins. Keep empty when no browser client is configured.
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL="mysql://safevault:safevault_dev_password@localhost:3307/safevault"
# Generate a unique 32+ character value before deploying.
JWT_SECRET=development-only-secret-change-before-production
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
